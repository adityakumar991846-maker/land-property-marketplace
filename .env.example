# TerraTrade Marketplace - Environment Variables Template
# Copy this file to .env for local development

# Django Security
DJANGO_SECRET_KEY="terratrade-production-secure-key-change-in-production"
DJANGO_DEBUG="True"
ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"

# PostgreSQL Primary Database Connection
# Format: postgres://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgres://terratrade_user:terratrade_password@localhost:5432/terratrade"

# Redis Cache & Django Channels Channel Layer (Optional for in-memory dev)
REDIS_URL="redis://localhost:6379/0"

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# AI Studio runtime injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
